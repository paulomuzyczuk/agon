# Copy to .env.local and fill in real values. Never commit .env.local.
# Next.js auto-loads .env.local; the tsx scripts load it via scripts/loadEnv.ts.
#
# Grouped REQUIRED (core) vs OPTIONAL (enables one integration). Every
# OPTIONAL integration already no-ops/degrades gracefully when its vars are
# unset (see each adapter's own module) — this grouping is a documentation
# clarity fix, not a behavior change (self-hosting decision, "Config/secrets
# templating" in CLAUDE.md).
#
# See also: config/athlete-profile.example.json (personal profile numbers —
# NOT env vars) and docs/training-program.example.md (your program). Run
# `pnpm bootstrap` to scaffold all of these from their examples in one step.

# ════════════════════════════════════════════════════════════════════════════
# REQUIRED — the app will not start meaningfully without these.
# ════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Decision (2026-07-23): Supabase Cloud, accessed as plain Postgres via this one
# connection string (option B). No @supabase/supabase-js — services/db.ts talks
# `pg` + plain SQL, so prod is just a different DATABASE_URL. SSL is auto-enabled
# for any remote host (see services/db.ts connectionNeedsSsl); local Docker stays
# plaintext. The seed guard refuses non-loopback hosts unless ALLOW_REMOTE_SEED=1.
#
#   local dev:  postgresql://agon:agon@127.0.0.1:5432/agon
#   production: Supabase → Project Settings → Database → Connection string.
#               Use the DIRECT connection or the SESSION pooler (port 5432) for
#               migrations, dbt, and Lightdash — NOT the transaction pooler
#               (6543), which drops the session state those tools need.
#   e.g. postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# ── Web bind / network exposure (self-hosting) ──────────────────────────────
# Where the Next.js server binds. Defaults to localhost-only — refuses an
# all-interfaces (0.0.0.0) bind unless AGON_WEB_ALLOW_PUBLIC is explicitly set
# (see lib/webBind.ts). Only used when running `pnpm start` directly on a host
# (not via Docker — see AGON_WEB_HOST_BIND_IP below for that case). See
# docs/self-hosting/network-exposure.md.
AGON_WEB_BIND_HOST=127.0.0.1
AGON_WEB_BIND_PORT=3000
# AGON_WEB_ALLOW_PUBLIC=true       # only if you run your own reverse proxy + TLS

# Docker Compose deployment: docker-compose.yml's `app` service always binds
# 0.0.0.0 INSIDE the container (safe — Docker's own network namespace is the
# boundary there) and instead controls real host-level exposure via its
# `ports:` mapping's host-IP prefix. Defaults to 127.0.0.1 (host-loopback
# only). Set this to your Tailscale IP (`tailscale ip -4`) to reach the app
# from another device over your tailnet — never a public/LAN-facing IP.
AGON_WEB_HOST_BIND_IP=127.0.0.1

# ── Login gate (self-hosting) ───────────────────────────────────────────────
# A single shared secret gates every page/API route (except /login) behind a
# signed, HttpOnly session cookie — network reachability (Tailscale) is NOT
# authentication (see docs/self-hosting/network-exposure.md). Generate both:
#   openssl rand -base64 32
# AGON_WEB_SECRET is never stored in plaintext: lib/auth/secretStore.ts hashes
# it (Argon2id) into data/auth/web-secret.hash on your first successful login
# and checks the hash from then on — no self-hoster action needed either way.
# AGON_SESSION_SIGNING_KEY only signs the session cookie and is deliberately a
# SEPARATE secret from the login password (mirrors the sibling Hephaistos
# project's signing-key split) — rotating one never invalidates the other.
# secret — the password you log in with
AGON_WEB_SECRET=
# secret — signs session cookies (independent of AGON_WEB_SECRET)
AGON_SESSION_SIGNING_KEY=
# AGON_WEB_SECRET_HASH=           # optional — pre-provision an Argon2id hash instead of migrating one
# AGON_WEB_SESSION_TTL_SECONDS=604800   # 7-day default (offline writes survive expiry)

# ════════════════════════════════════════════════════════════════════════════
# OPTIONAL — each integration below no-ops/degrades gracefully when unset.
# Enable only the ones you actually use.
# ════════════════════════════════════════════════════════════════════════════

# ── Strava (API v3, OAuth) — historical backfill / one-time enrichment ────────
# Create an app at https://www.strava.com/settings/api . The redirect URI's
# host must match the "Authorization Callback Domain" configured there
# (use "localhost" for the CLI auth flow). NOT the live run source (paywalled
# since 2026-06-30) — see Google Health below for that.
# public  — numeric client id
STRAVA_CLIENT_ID=
# secret  — client secret
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/strava/callback
# Recording devices whose activities are skipped on every Strava pull
# (comma-separated, matched case-insensitively). Unset = "Garmin Speed Sensor"
# (GPS-less wheel-sensor rides with no auto-pause); set empty to ingest all.
# STRAVA_IGNORED_DEVICES=Garmin Speed Sensor

# ── Fitbit (Web API, OAuth2) — legacy, deprecated in favor of Google Health ───
# Register a "Personal" app at https://dev.fitbit.com/apps (Personal = intraday
# HR is granted automatically). OAuth 2.0 Application Type: "Personal";
# Callback URL must match FITBIT_REDIRECT_URI exactly.
# public  — OAuth 2.0 Client ID
FITBIT_CLIENT_ID=
# secret  — client secret
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:3000/fitbit/callback

# ── Google Health API (v4, OAuth2) — PRIMARY live run source ──────────────────
# Run Ingestion Pivot (2026-07-24): the free replacement for Strava's now-paywalled
# API. Runs are recorded on a phone/watch + connected GPS and read server-side
# via the Google Health API. Setup (see scripts/google-health-auth.ts for the
# full walkthrough): Google Cloud Console → new project → enable the "Health
# API" → OAuth consent screen in "Testing" with you as the sole test user →
# create an OAuth client ID (Web application) whose Authorized redirect URI
# matches GOOGLE_HEALTH_REDIRECT_URI exactly. Then `pnpm gh:auth`. Each
# self-hoster creates their own OAuth app — this project never ships one.
# public  — OAuth 2.0 Client ID
GOOGLE_HEALTH_CLIENT_ID=
# secret  — client secret
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3000/google-health/callback

# ── Google Calendar API (v3, OAuth2) — training-schedule sync ──────────────────
# Pushes planned_sessions to a dedicated "Agon Training" calendar (+ an empty
# "Agon Meals" calendar), toggleable independently. Setup: reuse the same Google
# Cloud project as Google Health, enable the "Google Calendar API", add the scope
# https://www.googleapis.com/auth/calendar to the consent screen, and add
# GOOGLE_CALENDAR_REDIRECT_URI to the OAuth client's Authorized redirect URIs.
# (You may reuse the Health client id/secret if that OAuth client also lists this
# redirect URI + scope.) Then `pnpm gcal:auth`, then `pnpm gcal:sync`.
# public  — OAuth 2.0 Client ID
GOOGLE_CALENDAR_CLIENT_ID=
# secret  — client secret
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/google-calendar/callback

# ── Analytics warehouse roles (dbt + Lightdash) — Phase 3 ───────────────────────
# Least-privilege roles created by migrations/*_analytics_roles.sql. The role
# password is set out-of-band on the Postgres DB (ALTER ROLE ... PASSWORD);
# these vars are only read by dbt tooling, never the Next.js app.
#
# DBT_WRITER_USER/DBT_WRITER_PASSWORD are what analytics/dbt.sh and the
# `--profile analytics` compose service actually read (own the `analytics`
# schema). AGON_PG_*/AGON_DBT_WRITER_PASSWORD/AGON_LIGHTDASH_READER_PASSWORD
# below document the equivalent values for a Lightdash "PostgreSQL" connector
# pointed at the same warehouse (Supabase is just Postgres, no special adapter).
DBT_WRITER_USER=dbt_writer
# secret — local default: see analytics/dbt.sh's setup note
DBT_WRITER_PASSWORD=
AGON_PG_HOST=127.0.0.1           # prod: db.<ref>.supabase.co
AGON_PG_PORT=5432
AGON_PG_DATABASE=agon            # prod: postgres
# secret — owns the `analytics` schema (Lightdash connector)
AGON_DBT_WRITER_PASSWORD=
# secret — SELECT on `analytics` only
AGON_LIGHTDASH_READER_PASSWORD=
AGON_PG_SSLMODE=require          # set to `disable` for the local no-SSL stack

# ── LLM provider abstraction (voice-note parsing) ─────────────────────────────
# Per CLAUDE.md "Model Portability — No LLM Lock-In": provider + model come from
# env, prompts live in versioned templates (services/llm/prompts/), outputs
# validated with zod against our own schemas. Swapping providers = change these
# + one adapter file. Three adapters ship:
#   ollama     — LOCAL, free, open-source, NO API key, NO account with any AI
#                vendor. Any Ollama model (Qwen2.5 7B, Llama 3.1 8B) on your own
#                GPU/CPU. This is the default — mirrors the sibling Hephaistos
#                project's own default-to-Ollama choice, so a fresh self-hosted
#                install never locks you into Anthropic (or anyone else) just to
#                get voice-note parsing working. `ollama pull qwen2.5:7b`, then
#                set the three lines below (`--profile local-ai` in
#                docker-compose.yml runs Ollama itself for you).
#                Already running Ollama on this machine? Skip the container and
#                point AGON_LLM_BASE_URL at it, or keep the container and move
#                its host port with OLLAMA_HOST_PORT (default 11434) below.
#   claude-cli — runs the local `claude` CLI on your OWN Claude subscription. NO
#                API key / per-token credits — opt-in, for a machine where
#                Claude Code is already installed + logged in (e.g. this
#                project's own dev machine).
#   anthropic  — hosted Anthropic API. Needs AGON_LLM_API_KEY (metered) — opt-in,
#                BYOK (bring your own key), never required.
# Host port the `ollama` container publishes (default 11434). Change it when a
# host Ollama already holds that port ("port is already allocated").
# OLLAMA_HOST_PORT=11435
# Same for the self-hosted OpenRouteService (`ors-app`, default 8080).
# ORS_HOST_PORT=8081
AGON_LLM_PROVIDER=ollama         # ollama | claude-cli | anthropic
AGON_LLM_MODEL=qwen2.5:7b        # ollama tag, OR a claude alias / model id
AGON_LLM_CLAUDE_BIN=claude       # path to the `claude` CLI (claude-cli provider)
# secret — ONLY for provider=anthropic
AGON_LLM_API_KEY=
# optional — override (default http://localhost:11434 for ollama)
AGON_LLM_BASE_URL=

# ── Transcription (voice note → text; Whisper) ────────────────────────────────
# Three adapters ship (same portability rule as the LLM):
#   mlx-whisper — LOCAL, offline, free. Whisper via Apple's MLX (Apple Silicon),
#                 mirroring the pygmalion project. Needs NO API key. Requires a
#                 Python env (pip install -r scripts/requirements-transcription.txt)
#                 and ffmpeg (brew install ffmpeg). Apple Silicon only. This is
#                 the default.
#   whisper-cpp — LOCAL, offline, free, open-source. Whisper via whisper.cpp (CPU
#                 or CUDA GPU) — the local STT path on a self-hosted Linux server
#                 (mlx is Apple-only). NO API key. Needs ffmpeg + a built
#                 whisper.cpp on PATH and a GGML model file;
#                 AGON_TRANSCRIPTION_MODEL is the .bin PATH. Bridge:
#                 scripts/whisper_cpp_transcribe.sh.
#                 The transcription runs INSIDE the bot container, so these must be
#                 in that image. With Docker on Linux use docker-compose.voice.yml
#                 (docs/self-hosting/telegram.md → "Voice notes") and set
#                   AGON_TRANSCRIPTION_PROVIDER=whisper-cpp
#                   AGON_TRANSCRIPTION_MODEL=/opt/whisper/models/model.bin
#   openai      — HOSTED Whisper. Needs AGON_TRANSCRIPTION_API_KEY. Zero-setup
#                 fallback on any host.
# Whisper model size the voice overlay (docker-compose.voice.yml) bakes into the bot
# image: tiny | base | small | medium (default medium, ~1.5 GB; small is ~470 MB).
# Read by Compose at build time, not by the app.
# AGON_WHISPER_MODEL=small
AGON_TRANSCRIPTION_PROVIDER=mlx-whisper   # mlx-whisper | whisper-cpp | openai
AGON_TRANSCRIPTION_MODEL=mlx-community/whisper-medium-mlx  # mlx repo, whisper.cpp .bin path, or whisper-1
AGON_TRANSCRIPTION_PYTHON=python3   # path to the python that has mlx-whisper
AGON_TRANSCRIPTION_WHISPER_BIN=whisper-cli   # whisper.cpp CLI (whisper-cpp provider)
# secret — ONLY for provider=openai
AGON_TRANSCRIPTION_API_KEY=
# optional — override base URL (openai)
AGON_TRANSCRIPTION_BASE_URL=

# ── Telegram bot (capture pipeline) ─────────────────────────────────────────
# Bot token from @BotFather. TELEGRAM_WEBHOOK_SECRET is the value passed as
# `secret_token` when registering the webhook; the /api/telegram/webhook route
# rejects calls whose X-Telegram-Bot-Api-Secret-Token header doesn't match.
# The long-poll listener (pnpm telegram:poll, the recommended self-hosted path —
# no public URL needed) doesn't need TELEGRAM_WEBHOOK_SECRET at all.
# secret — from @BotFather
TELEGRAM_BOT_TOKEN=
# secret — shared webhook auth token (webhook mode only)
TELEGRAM_WEBHOOK_SECRET=
# Chat id the data-freshness dead-man's switch alerts (pnpm data:freshness).
# Unset = the check still runs and still fails loudly, it just prints instead of
# messaging. Find it by sending the bot any message and reading getUpdates.
# numeric chat id of the athlete
TELEGRAM_OWNER_CHAT_ID=

# ── MCP consulting layer (read-only) ──────────────────────────────────────────
# The MCP server (`pnpm mcp`) queries the DB read-only. Optional: point this at a
# least-privilege read role (the `mcp_reader` role from the migrations) so access
# is locked down at the DB level too; if unset it falls back to DATABASE_URL and
# relies on the server's READ ONLY transactions. Wire the server into Claude Code
# via .mcp.json in the repo root.
MCP_DATABASE_URL=

# ── Knowledge vault (consulting/MCP layer) ────────────────────────────────────
# ABSOLUTE path OUTSIDE this repo. Vault content is copyrighted and must never
# enter git. No default inside the repo (CLAUDE.md Knowledge Vault Policy). The
# repo ships vault.example/ showing the page format — copy it somewhere private
# and point AGON_VAULT_PATH there.
AGON_VAULT_PATH=

# ── Athlete profile + training program (self-hosting) ──────────────────────────
# Your personal numbers (time zone, program dates/lengths, HR/sweat anchors) and
# program document, both read from private local files, never hardcoded — same
# rationale as the vault + nutrition goals below. Optional overrides; default to
# the *.local.json / *.local.md paths next to their *.example.* templates.
# Copy the .example files, fill in your own values, then (re)start the app.
# default: config/athlete-profile.local.json
AGON_ATHLETE_PROFILE_PATH=

# ── Nutrition goals (modular, per-user) ─────────────────────────────────────────
# Water/supplement/macro targets are seeded from a private JSON file, never
# hardcoded (nutrition decision 2026-08-24). Optional — defaults to
# config/nutrition-goals.local.json (gitignored) if unset. Copy
# config/nutrition-goals.example.json to that path (or wherever this points) and
# fill in real values, then `pnpm seed:nutrition-goals`.
AGON_NUTRITION_GOALS_PATH=

# ── Route builder (OpenRouteService, OSM) — Premium-Parity #6 ──────────────────
# Natural-language, target-distance running-route loops (CLAUDE.md #6). Generation
# uses OpenRouteService (options.round_trip, foot-walking) — Google Maps can't
# target a distance and is billed, so we stay on free/OSM routing. Sign up free at
# https://openrouteservice.org → Dashboard → request a token; the free tier also
# covers the Pelias geocoder used to resolve place names. ORS_BASE_URL is only set
# to point at a self-hosted ORS (`--profile local-routing` in docker-compose.yml) —
# leave it unset for the hosted API. Provider-neutral by construction: a
# GraphHopper adapter would add its own key here without touching the routing code.
# secret — OpenRouteService API token
ORS_API_KEY=
# ORS_BASE_URL=http://localhost:8080/ors   # point at a self-hosted ORS (docker-compose.yml --profile local-routing)
# Geocoding (place-name → coords + route "via" descriptions) uses Pelias, which a
# self-hosted ORS does NOT include — so keep geocoding on the hosted free tier
# even when ORS_BASE_URL is local. Defaults to the hosted API; only set to point
# at a self-hosted Pelias later.
# ORS_GEOCODE_BASE_URL=https://api.openrouteservice.org
# Optional client-side pacing between ORS calls (ms). Generating 3 diverse,
# place-described routes per run makes many calls; gcal:sync sets this to ~1700
# (≈35/min) to stay under the free-tier limit. Leave unset for the fast
# interactive `route:suggest`; raise/lower for a self-hosted ORS with no limit.
# ORS_MIN_INTERVAL_MS=1700
# Radius (km) of the local-first place-name search. Geocoding looks inside this
# circle around the reference point (the run's start, else home) FIRST, and only
# retries worldwide if nothing is found — so a bare "Tiergarten" resolves to the
# Berlin one rather than the Austrian one, while place names abroad still work
# when travelling. Raise only if a waypoint you name sits further out than this.
# ROUTING_GEOCODE_RADIUS_KM=75
# Point-to-point directions fall back to the FOSSGIS OSRM servers
# (routing.openstreetmap.de — free, keyless, ≤1 req/s) once ORS answers "quota
# exceeded"; loops stay ORS-only. Set to 0 to disable; OSRM_BASE_URL points at a
# self-hosted OSRM instead (needs routed-foot/ and routed-bike/ path prefixes).
# ROUTING_FALLBACK_OSRM=1
# OSRM_BASE_URL=https://routing.openstreetmap.de
# "through <area>" vias (a forest, park, lake) are resolved to their OSM polygon
# via Nominatim (free, keyless, ≤1 req/s) so the detour stays inside the area.
# Set ROUTING_AREA_LOOKUP=0 to treat every via as a plain point.
# ROUTING_AREA_LOOKUP=1
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Time-trial routes are picked on traffic lights / crossings counted from
# OpenStreetMap via Overpass (free, keyless, rate-limited). Only the middle of
# each route is sent — the first/last 300 m (home) are cut. Set
# ROUTING_CROSSINGS=0 to skip counting; OVERPASS_BASE_URL for a self-hosted one.
# ROUTING_CROSSINGS=1
# OVERPASS_BASE_URL=https://overpass-api.de/api

# Home location (decimal degrees). Resolved once from your home address via the
# ORS geocoder and pinned here so "run 25 km from home" needs no coordinates.
# Also the weather fallback for activities recorded without GPS (MZY-226).
# A home address is PII — keep the real values in .env.local only.
# e.g. 52.5163 (Brandenburger Tor)
AGON_HOME_LAT=
# e.g. 13.3777
AGON_HOME_LNG=
# Workplace — the other end of the commute rides (athlete profile `commute`).
# Same PII rule as home: real values in .env.local only. Unset → commute rides
# still sync, just without route links.
# e.g. 52.4730 (Tempelhofer Feld)
AGON_WORK_LAT=
# e.g. 13.4030
AGON_WORK_LNG=

# ── Backups & one-off imports (optional) ─────────────────────────────────────
# Read only by the tsx scripts below, never by the app. All optional.
# Where `pnpm db:backup` writes dumps (default ./backups, gitignored). Point it at
# another disk or a synced folder: dumps next to the data do not survive a disk loss.
# AGON_BACKUP_DIR=/path/to/backups
# Name of the Postgres container the backup script `docker exec`s into
# (default agon-db-1, the name Compose gives the `db` service).
# AGON_DB_CONTAINER=agon-db-1
# Docker engine the backup scripts talk to (unix://, tcp:// or ssh://). Set it when
# the `docker` CLI resolves to the wrong engine under a scheduler, e.g. Docker
# Desktop's context instead of the native one: unix:///var/run/docker.sock
# AGON_DOCKER_HOST=unix:///var/run/docker.sock
# Cardio-comments sheet for `pnpm notes:import-cardio` (default data/cardio-sheet.local.json).
# AGON_CARDIO_SHEET_PATH=data/cardio-sheet.local.json
# Lab import (`pnpm import:labs`): rows below this confidence (0-1) are flagged for review
# instead of imported silently (default 0.85).
# AGON_LAB_OCR_CONFIDENCE_MIN=0.85

# ── Android app (Capacitor shell, MZY-274) ──────────────────────────────────
# Only needed to BUILD the sideloaded Android APK (pnpm android:sync /
# android:build) — the server never reads these. See
# docs/self-hosting/android-app.md.
# The Agon server the app loads. Must be a secure origin: https:// (e.g. the
# tower via `tailscale serve`), or http://127.0.0.1:<port> in dev through
# `adb reverse`. Plain http to a LAN/Tailscale IP is refused — the WebView
# treats it as insecure and the recorder breaks there (lib/androidShell.ts).
# Baked into the APK at sync time: change it → re-sync + rebuild.
# AGON_ANDROID_SERVER_URL=https://<machine>.<tailnet>.ts.net
# Build toolchain, read from the shell environment: JDK 21 and the Android SDK
# (platform 36 + build-tools). `pnpm android:build` stops with a clear message if
# either is missing.
# JAVA_HOME=/path/to/jdk-21
# ANDROID_HOME=/path/to/Android/sdk
# Release signing. The keystore lives OUTSIDE the repo; back it up — losing it
# means the phone refuses every future APK as an update.
# AGON_ANDROID_KEYSTORE_PATH=          # absolute path, e.g. /Users/<you>/.agon/agon-release.jks
# AGON_ANDROID_KEYSTORE_PASSWORD=      # secret
# AGON_ANDROID_KEY_ALIAS=agon
# AGON_ANDROID_KEY_PASSWORD=           # secret
# Opt-in: let Chrome DevTools (chrome://inspect) attach to the release-signed
# app WebView. Read at `cap sync` time. Leave unset for everyday builds.
# AGON_ANDROID_WEBVIEW_DEBUG=1
