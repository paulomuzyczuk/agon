# Every 3 hours for the user-level sync (agon-sync.service in this folder).
#
# See that unit for what it does and how to install both files.

[Unit]
Description=Sync Agon from Google Health and Strava every 3 hours

[Timer]
# 00:15, 03:15, 06:15 ... local time. Google Health pages the whole history on
# every run (MZY-405), so more often than this costs API quota for little.
OnCalendar=*-*-* 00/3:15:00
RandomizedDelaySec=300
# A tower that was off syncs as soon as it is back.
Persistent=true

[Install]
WantedBy=timers.target
