# Daily schedule for the Agon Postgres backup (agon-backup.service).
#
# See that unit for what it does and how to install both files.

[Unit]
Description=Back up the Agon database daily
Requires=agon-backup.service

[Timer]
# 03:30 local: after the day's ingestion has settled, before the 08:00
# freshness check (so a failed backup and a stale source land together).
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=300
# A tower that was off at 03:30 backs up as soon as it's back.
Persistent=true

[Install]
WantedBy=timers.target
