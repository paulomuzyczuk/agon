<?xml version="1.0" encoding="utf-8"?>
<!-- MZY-274 (MZY-273 spike finding): no cloud backup and no device-to-device
     transfer. Android's auto-backup restarted the app mid-recording (losing
     the WebView's in-memory sample queue) and would copy the WebView's data,
     including the session cookie, to Google. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
